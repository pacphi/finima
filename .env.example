# Finima — Environment Variables (secrets only)     

# Copy this file to .env and fill in the values.
# These override the corresponding YAML config keys.
   
# --- Database ---             
# POSTGRES_PASSWORD is the single source of truth for the DB password.
# It is used by both the postgres container and the app (via APP__DATABASE__PASSWORD).
POSTGRES_PASSWORD=YOUR_PASSWORD
APP__DATABASE__PASSWORD=${POSTGRES_PASSWORD}                  
APP__DATABASE__HOST=localhost
APP__DATABASE__USER=finima     
APP__DATABASE__NAME=finima   
                               
# JWT signing secret (generate with: openssl rand -base64 32)
APP__AUTH__JWT_SECRET=change-me-to-a-random-secret            
   
# Resend API key for magic link emails (https://resend.com) 
APP__RESEND__API_KEY=re_your_api_key_here

# --- MinIO / S3 Object Storage ---
MINIO_ROOT_USER=finima
MINIO_ROOT_PASSWORD=finima_dev 
S3_REGION=us-east-1
S3_BUCKET=finima-uploads       
                               
# --- Database Backups ---   
BACKUP_RETENTION_DAYS=30

# --- Observability (SigNoz) ---
# SIGNOZ_ENDPOINT=http://signoz:4317