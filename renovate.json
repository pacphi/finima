{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Managed from pacphi/mise-dotfiles. Replaces Dependabot version updates (2026-10-21).",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "cargo: settings",
      "matchCategories": [
        "rust"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "rust"
      ],
      "commitMessagePrefix": "deps(rust):"
    },
    {
      "description": "npm frontend/**: settings",
      "matchCategories": [
        "js"
      ],
      "matchFileNames": [
        "frontend/**"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "typescript"
      ],
      "commitMessagePrefix": "deps(ts):"
    },
    {
      "description": "docker: settings",
      "matchCategories": [
        "docker"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "docker"
      ],
      "commitMessagePrefix": "deps(docker):"
    },
    {
      "description": "docker frontend/**: settings",
      "matchCategories": [
        "docker"
      ],
      "matchFileNames": [
        "frontend/**"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "docker"
      ],
      "commitMessagePrefix": "deps(docker):"
    },
    {
      "description": "github-actions: settings",
      "matchCategories": [
        "ci"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "github-actions"
      ],
      "commitMessagePrefix": "deps(actions):"
    }
  ]
}
